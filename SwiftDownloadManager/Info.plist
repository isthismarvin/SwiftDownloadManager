<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ein Download-Manager muss auch http://-URLs laden können.
	     Ohne diese Ausnahme blockiert App Transport Security jeden
	     Klartext-Download mit einem kryptischen Fehler. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>nrw.marvin.SwiftDownloadManager</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>swiftdownloadmanager</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
